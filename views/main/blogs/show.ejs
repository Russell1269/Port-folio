<% layout('layout/boilerplate') -%>

<%
  const words = (blog.content || "").trim().split(/\s+/).filter(Boolean).length;
  const readTime = Math.max(1, Math.ceil(words / 200));
  const hasCover = Boolean(blog.coverImage);

  // Translated body: `blog.content_bn` wins, then translations.bn.content,
  // then the English `content`. Long-form HTML is never duplicated into
  // `title_bn`-style columns (see model/blog.js).
  const blogTitle = localized(blog, 'title');
  const blogSummary = localized(blog, 'summary');
  const blogContent =
    (blog.translations && blog.translations[lng] && blog.translations[lng].content) ||
    blog.content || "";

  const statusStyles = {
    published: "border-emerald-400/20 bg-emerald-500/10 text-emerald-300",
    draft: "border-amber-400/20 bg-amber-500/10 text-amber-300",
    archived: "border-slate-400/20 bg-slate-500/10 text-slate-300",
  };
  const statusDot = {
    published: "bg-emerald-400",
    draft: "bg-amber-400",
    archived: "bg-slate-400",
  };
  const statusClass = statusStyles[blog.status] || statusStyles.draft;
  const dotClass = statusDot[blog.status] || statusDot.draft;
%>

<section class="relative overflow-hidden pb-20 pt-4">
  <!-- Ambient glows (matches home page) -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-40 left-1/4 h-[30rem] w-[30rem] rounded-full bg-cyan-500/10 blur-[140px]"></div>
    <div class="absolute right-0 top-1/3 h-[26rem] w-[26rem] rounded-full bg-purple-600/10 blur-[140px]"></div>
    <div class="absolute bottom-0 left-0 h-80 w-80 rounded-full bg-sky-500/10 blur-[120px]"></div>
  </div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
    <!-- ================= Breadcrumb & Back ================= -->
    <div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <nav aria-label="Breadcrumb" class="min-w-0">
        <ol class="flex flex-wrap items-center gap-2 text-xs text-slate-500 sm:text-sm">
          <li>
            <a href="<%= localizedUrl('/') %>" class="inline-flex items-center gap-2 transition-colors duration-300 hover:text-cyan-400">
              <i class="fa-solid fa-house text-[11px]"></i>
              <%= t('blogs:show.home') %>
            </a>
          </li>
          <li class="text-slate-700">/</li>
          <li>
            <a href="<%= localizedUrl('/blogs') %>" class="transition-colors duration-300 hover:text-cyan-400"><%= t('blogs:show.blogs') %></a>
          </li>
          <li class="text-slate-700">/</li>
          <li class="max-w-[180px] truncate font-medium text-slate-300 sm:max-w-xs"><%= blogTitle %></li>
        </ol>
      </nav>

      <a href="<%= localizedUrl('/blogs') %>" class="group inline-flex w-fit items-center gap-2 rounded-2xl border border-white/10 bg-white/5 px-5 py-2.5 text-sm font-medium text-slate-300 backdrop-blur-xl transition-all duration-300 ease-out hover:scale-[1.01] hover:border-cyan-500/30 hover:bg-white/10 hover:text-white hover:shadow-lg hover:shadow-cyan-950/20">
        <i class="fa-solid fa-arrow-left text-xs transition-transform duration-300 group-hover:-translate-x-1"></i>
        <%= t('blogs:show.back') %>
      </a>
    </div>

    <!-- ================= Layout: Article + Sidebar ================= -->
    <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[minmax(0,1fr)_340px]">
      <!-- ---------- ARTICLE ---------- -->
      <article class="w-full rounded-[35px] border border-white/10 bg-white/5 p-6 shadow-[0_30px_80px_rgba(0,0,0,.4)] backdrop-blur-xl sm:p-8 lg:p-10">
        <!-- Status / Actions -->
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 pb-6">
          <span class="inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-xs font-semibold uppercase tracking-widest <%= statusClass %>">
            <span class="h-1.5 w-1.5 animate-pulse rounded-full <%= dotClass %>"></span>
            <%= t(`blogs:status.${blog.status}`) %>
          </span>

          <% if (isOwner) { %>
          <div class="flex items-center gap-2 sm:gap-3">
            <a href="<%= localizedUrl('/blogs/' + blog._id + '/edit') %>" class="inline-flex items-center gap-2 rounded-xl border border-cyan-500/20 bg-cyan-500/10 px-3.5 py-2 text-xs font-medium text-cyan-300 transition-all duration-300 ease-out hover:scale-[1.01] hover:border-cyan-500/40 hover:bg-cyan-500/20 hover:shadow-lg hover:shadow-cyan-950/20">
              <i class="fa-solid fa-pen text-[11px]"></i>
              <%= t('blogs:show.edit') %>
            </a>

            <form action="/blogs/<%= blog._id %>?_method=DELETE" method="POST" onsubmit="return confirm('<%= t('blogs:show.deleteConfirm') %>')">
              <button type="submit" class="inline-flex items-center gap-2 rounded-xl border border-rose-500/20 bg-rose-500/10 px-3.5 py-2 text-xs font-medium text-rose-300 transition-all duration-300 ease-out hover:scale-[1.01] hover:border-rose-500/40 hover:bg-rose-500/20 hover:shadow-lg hover:shadow-rose-950/20">
                <i class="fa-solid fa-trash-can text-[11px]"></i>
                <%= t('blogs:show.delete') %>
              </button>
            </form>
          </div>
          <% } %>
        </div>

        <!-- Title -->
        <h1 class="mt-8 text-3xl font-black leading-[1.15] tracking-tight text-white sm:text-4xl lg:text-5xl">
          <%= blogTitle %>
        </h1>

        <!-- Summary -->
        <% if (blogSummary) { %>
        <p class="mt-6 rounded-r-2xl border-l-2 border-cyan-400 bg-cyan-500/5 py-3 pl-5 text-base leading-8 text-slate-300 sm:text-lg">
          <%= blogSummary %>
        </p>
        <% } %>

        <!-- Meta -->
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 border-y border-white/10 py-4 text-xs text-slate-400 sm:text-sm">
          <div class="flex items-center gap-2">
            <i class="fa-regular fa-calendar text-cyan-400"></i>
            <time datetime="<%= blog.publishedAt ? new Date(blog.publishedAt).toISOString() : '' %>">
              <%= formatDate(blog.publishedAt || blog.createdAt) %>
            </time>
          </div>

          <div class="flex items-center gap-2">
            <i class="fa-regular fa-clock text-purple-400"></i>
            <span><%= t('blogs:show.readTime', { count: readTime }) %></span>
          </div>

          <div class="flex min-w-0 items-center gap-2">
            <i class="fa-solid fa-link text-slate-500"></i>
            <span class="truncate font-mono text-xs text-slate-500">/blogs/<%= blog.slug %></span>
          </div>
        </div>

        <!-- Cover -->
        <% if (hasCover) { %>
        <figure class="group relative mt-8 overflow-hidden rounded-[25px] border border-white/10 bg-slate-900">
          <img src="<%= blog.coverImage.url %>" alt="<%= blog.coverImageAlt || blogTitle %>" loading="lazy" class="h-56 w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03] sm:h-72 md:h-96" />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/10 to-transparent"></div>

          <% if (blog.coverImageAlt) { %>
          <figcaption class="absolute bottom-4 right-4 max-w-[80%] truncate rounded-xl border border-white/10 bg-slate-950/60 px-3 py-1.5 text-[11px] text-slate-300 backdrop-blur-xl">
            <%= blog.coverImageAlt %>
          </figcaption>
          <% } %>
        </figure>
        <% } %>

        <!-- Tags -->
        <% if (blog.tags && blog.tags.length) { %>
        <div class="mt-8 flex flex-wrap gap-2 rounded-[25px] border border-white/10 bg-white/5 p-4 backdrop-blur-xl">
          <% blog.tags.forEach((tag) => { %>
          <a href="<%= localizedUrl('/blogs?tag=' + encodeURIComponent(tag)) %>" class="rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-xs font-medium text-slate-300 transition-all duration-300 ease-out hover:scale-[1.03] hover:border-cyan-500/30 hover:text-cyan-300 hover:shadow-lg hover:shadow-cyan-950/20">
            #<%= tag %>
          </a>
          <% }); %>
        </div>
        <% } %>

        <!-- Content -->
        <div class="prose prose-invert prose-slate mt-10 max-w-none leading-8 prose-headings:font-bold prose-headings:text-white prose-p:text-slate-300 prose-a:text-cyan-400 prose-a:no-underline hover:prose-a:text-cyan-300 hover:prose-a:underline prose-strong:text-white prose-blockquote:rounded-r-xl prose-blockquote:border-cyan-400/40 prose-blockquote:bg-cyan-500/5 prose-blockquote:not-italic prose-code:rounded prose-code:bg-slate-900/80 prose-code:px-1.5 prose-code:py-0.5 prose-code:text-cyan-300 prose-code:before:content-none prose-code:after:content-none prose-pre:rounded-2xl prose-pre:border prose-pre:border-white/10 prose-pre:bg-slate-900/90 prose-img:rounded-[25px] prose-img:border prose-img:border-white/10 prose-hr:border-white/10">
          <%- blogContent %>
        </div>
      </article>

      <!-- ---------- SIDEBAR ---------- -->
      <aside class="w-full space-y-8 lg:sticky lg:top-24">
        <!-- Author / About -->
        <div class="rounded-[35px] border border-white/10 bg-white/5 p-6 backdrop-blur-xl transition-all duration-300 ease-out hover:border-cyan-500/30 hover:shadow-lg hover:shadow-cyan-950/20">
          <div class="flex items-center gap-4">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border border-cyan-400/20 bg-cyan-500/10 text-cyan-300">
              <i class="fa-solid fa-terminal"></i>
            </div>
            <div class="min-w-0">
              <p class="truncate font-semibold text-white"><%= t('footer:brand.name') %></p>
              <p class="text-xs text-slate-400"><%= t('blogs:show.authorRole') %></p>
            </div>
          </div>

          <p class="mt-5 text-sm leading-7 text-slate-400">
            <%= t('blogs:show.authorBio') %>
          </p>

          <div class="mt-6 flex flex-wrap gap-3">
            <a href="<%= localizedUrl('/contact') %>" class="inline-flex flex-1 items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-cyan-500 to-blue-600 px-5 py-3 text-sm font-semibold text-white transition-all duration-300 ease-out hover:scale-[1.01] hover:shadow-[0_20px_60px_rgba(34,211,238,.25)]">
              <i class="fa-regular fa-paper-plane text-xs"></i>
              <%= t('blogs:show.getInTouch') %>
            </a>
            <a href="<%= localizedUrl('/about') %>" class="inline-flex flex-1 items-center justify-center gap-2 rounded-2xl border border-white/10 bg-white/5 px-5 py-3 text-sm font-medium text-slate-300 transition-all duration-300 ease-out hover:scale-[1.01] hover:border-cyan-500/30 hover:bg-white/10 hover:text-white">
              <%= t('blogs:show.aboutMe') %>
            </a>
          </div>
        </div>

        <!-- Article info -->
        <div class="rounded-[35px] border border-white/10 bg-white/5 p-6 backdrop-blur-xl transition-all duration-300 ease-out hover:border-cyan-500/30 hover:shadow-lg hover:shadow-cyan-950/20">
          <h2 class="flex items-center gap-3 text-lg font-bold text-white">
            <i class="fa-solid fa-circle-info text-cyan-400"></i>
            <%= t('blogs:show.infoTitle') %>
          </h2>

          <dl class="mt-5 grid grid-cols-2 gap-4">
            <div class="rounded-[25px] border border-white/10 bg-white/5 p-4">
              <dt class="text-xs text-slate-500"><%= t('blogs:show.readTimeLabel') %></dt>
              <dd class="mt-1 text-lg font-bold text-cyan-300"><%= t('blogs:show.readTimeValue', { count: formatNumber(readTime) }) %></dd>
            </div>

            <div class="rounded-[25px] border border-white/10 bg-white/5 p-4">
              <dt class="text-xs text-slate-500"><%= t('blogs:show.words') %></dt>
              <dd class="mt-1 text-lg font-bold text-purple-300"><%= formatNumber(words) %></dd>
            </div>

            <div class="col-span-2 rounded-[25px] border border-white/10 bg-white/5 p-4">
              <dt class="text-xs text-slate-500"><%= t('blogs:show.published') %></dt>
              <dd class="mt-1 text-sm font-semibold text-slate-200">
                <%= formatDate(blog.publishedAt || blog.createdAt) %>
              </dd>
            </div>

            <div class="col-span-2 rounded-[25px] border border-white/10 bg-white/5 p-4">
              <dt class="text-xs text-slate-500"><%= t('blogs:show.slug') %></dt>
              <dd class="mt-1 truncate font-mono text-xs text-slate-300"><%= blog.slug %></dd>
            </div>
          </dl>
        </div>

        <!-- Tags -->
        <% if (blog.tags && blog.tags.length) { %>
        <div class="rounded-[35px] border border-white/10 bg-white/5 p-6 backdrop-blur-xl transition-all duration-300 ease-out hover:border-cyan-500/30 hover:shadow-lg hover:shadow-cyan-950/20">
          <h2 class="flex items-center gap-3 text-lg font-bold text-white">
            <i class="fa-solid fa-tags text-purple-400"></i>
            <%= t('blogs:show.topics') %>
          </h2>

          <div class="mt-5 flex flex-wrap gap-2">
            <% blog.tags.forEach((tag) => { %>
            <a href="<%= localizedUrl('/blogs?tag=' + encodeURIComponent(tag)) %>" class="rounded-full border border-white/10 bg-white/5 px-3.5 py-1.5 text-xs font-medium text-slate-300 transition-all duration-300 ease-out hover:scale-[1.03] hover:border-cyan-500/30 hover:text-cyan-300">
              #<%= tag %>
            </a>
            <% }); %>
          </div>
        </div>
        <% } %>
      </aside>
    </div>

    <!-- ================= Previous / Next ================= -->
    <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-2">
      <a href="<%= localizedUrl(previousPost ? '/blogs/' + previousPost.slug : '/blogs') %>" class="group w-full rounded-[35px] border border-white/10 bg-white/5 p-6 backdrop-blur-xl transition-all duration-300 ease-out <%= previousPost ? 'hover:scale-[1.01] hover:border-cyan-500/30 hover:shadow-lg hover:shadow-cyan-950/20' : 'pointer-events-none opacity-50' %>">
        <div class="flex items-center gap-2 text-xs uppercase tracking-widest text-slate-500">
          <i class="fa-solid fa-chevron-left text-cyan-400 transition-transform duration-300 group-hover:-translate-x-1"></i>
          <%= t('blogs:show.previous') %>
        </div>
        <h3 class="mt-3 line-clamp-2 font-semibold leading-7 text-slate-200 transition-colors duration-300 group-hover:text-cyan-300">
          <%= previousPost ? localized(previousPost, 'title') : t('blogs:show.noPrevious') %>
        </h3>
      </a>

      <a href="<%= localizedUrl(nextPost ? '/blogs/' + nextPost.slug : '/blogs') %>" class="group w-full rounded-[35px] border border-white/10 bg-white/5 p-6 text-right backdrop-blur-xl transition-all duration-300 ease-out <%= nextPost ? 'hover:scale-[1.01] hover:border-cyan-500/30 hover:shadow-lg hover:shadow-cyan-950/20' : 'pointer-events-none opacity-50' %>">
        <div class="flex items-center justify-end gap-2 text-xs uppercase tracking-widest text-slate-500">
          <%= t('blogs:show.next') %>
          <i class="fa-solid fa-chevron-right text-purple-400 transition-transform duration-300 group-hover:translate-x-1"></i>
        </div>
        <h3 class="mt-3 line-clamp-2 font-semibold leading-7 text-slate-200 transition-colors duration-300 group-hover:text-purple-300">
          <%= nextPost ? localized(nextPost, 'title') : t('blogs:show.noNext') %>
        </h3>
      </a>
    </div>

    <!-- ================= Back CTA ================= -->
    <div class="mt-12 text-center">
      <a href="<%= localizedUrl('/blogs') %>" class="inline-flex w-full items-center justify-center gap-3 rounded-2xl border border-white/10 bg-white/5 px-8 py-4 text-sm font-medium text-slate-200 backdrop-blur-xl transition-all duration-300 ease-out hover:scale-[1.01] hover:border-cyan-500/30 hover:bg-white/10 hover:text-white hover:shadow-lg hover:shadow-cyan-950/20 sm:w-auto">
        <i class="fa-solid fa-arrow-left text-xs"></i>
        <%= t('blogs:show.backAll') %>
      </a>
    </div>
  </div>
</section>