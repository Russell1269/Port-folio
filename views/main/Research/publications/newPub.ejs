<% layout('layout/boilerplate') -%>

<!--
  Submission view for the Publications module.
  Every input `name` maps 1:1 with the Mongoose Publication schema:
  title, URL, DOI, publishedIn, publisher, publishedAt, abstract, featured
-->
<section class="relative pb-24">
  <div class="mx-auto max-w-4xl px-1 sm:px-4 lg:px-6">
    <div class="relative overflow-hidden rounded-[35px] border border-white/10 bg-white/[0.02] p-6 sm:p-10 md:p-12 backdrop-blur-2xl shadow-2xl">
      <!-- Ambient glow layers -->
      <div class="pointer-events-none absolute -top-40 -right-40 h-96 w-96 rounded-full bg-cyan-500/5 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-40 -left-40 h-96 w-96 rounded-full bg-purple-500/5 blur-3xl"></div>

      <!-- Header -->
      <div class="relative mb-10 border-b border-white/5 pb-6">
        <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-cyan-400/20 bg-cyan-500/10 px-4 py-1.5">
          <span class="h-2 w-2 rounded-full bg-cyan-400 animate-pulse"></span>
          <span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-cyan-300">Research Archive</span>
        </div>

        <h1 class="text-2xl font-bold tracking-tight text-white sm:text-3xl md:text-4xl">
          <i class="fas fa-file-invoice mr-3 text-cyan-400"></i>Add New
          Publication
        </h1>
        <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-400">
          Publish institutional indexing records, whitepapers, journals, or
          conference proceedings straight onto your dashboard catalog feed.
        </p>
      </div>

      <!-- Submission route -->
      <form action="/research/publications" method="POST" class="relative space-y-8">
        <!-- SEGMENT 1: Core Mapping -->
        <fieldset class="space-y-6">
          <legend class="mb-4 text-xs font-bold uppercase tracking-wider text-cyan-400">
            <i class="fas fa-bookmark mr-2"></i>1. Core Mapping
          </legend>

          <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            <!-- Title -->
            <div class="space-y-2 md:col-span-2">
              <label for="title" class="block text-xs font-semibold uppercase tracking-wider text-slate-400">Publication Title <span class="text-cyan-400">*</span></label>
              <div class="relative">
                <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-600">
                  <i class="fas fa-heading"></i>
                </span>
                <input id="title" type="text" name="title" required maxlength="100" autocomplete="off" placeholder="e.g. Diagnosing Liver Diseases Manually Using Deep Learning..." class="w-full rounded-xl border border-white/10 bg-[#0b0f19]/60 py-3.5 pl-11 pr-4 text-sm text-white placeholder:text-slate-600 transition duration-200 focus:border-cyan-500/20 focus:outline-none focus:ring-2 focus:ring-cyan-500/30" />
              </div>
              <p class="text-[10px] leading-relaxed text-slate-500">
                The pre-validate model hook auto-compiles your routing slug from
                this value.
              </p>
            </div>

            <!-- External URL -->
            <div class="space-y-2">
              <label for="URL" class="block text-xs font-semibold uppercase tracking-wider text-slate-400">External Destination URL
                <span class="text-cyan-400">*</span></label>
              <div class="relative">
                <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-600">
                  <i class="fas fa-link"></i>
                </span>
                <input id="URL" type="url" name="URL" required placeholder="https://ieee.org/..." class="w-full rounded-xl border border-white/10 bg-[#0b0f19]/60 py-3.5 pl-11 pr-4 text-sm text-white placeholder:text-slate-600 transition duration-200 focus:border-cyan-500/20 focus:outline-none focus:ring-2 focus:ring-cyan-500/30" />
              </div>
            </div>

            <!-- DOI -->
            <div class="space-y-2">
              <label for="DOI" class="block text-xs font-semibold uppercase tracking-wider text-slate-400">Digital Object Identifier (DOI)
                <span class="text-cyan-400">*</span></label>
              <div class="relative">
                <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-600">
                  <i class="fas fa-fingerprint"></i>
                </span>
                <input id="DOI" type="text" name="DOI" required autocomplete="off" placeholder="e.g. 10.1109/ICAECA.2025.1044812" class="w-full rounded-xl border border-white/10 bg-[#0b0f19]/60 py-3.5 pl-11 pr-4 text-sm text-white placeholder:text-slate-600 transition duration-200 focus:border-cyan-500/20 focus:outline-none focus:ring-2 focus:ring-cyan-500/30" />
              </div>
            </div>
          </div>
        </fieldset>

        <!-- SEGMENT 2: Issuer Registry Records -->
        <fieldset class="space-y-6 border-t border-white/5 pt-6">
          <legend class="mb-4 text-xs font-bold uppercase tracking-wider text-cyan-400">
            <i class="fas fa-university mr-2"></i>2. Issuer Registry Records
          </legend>

          <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            <!-- Published In -->
            <div class="space-y-2">
              <label for="publishedIn" class="block text-xs font-semibold uppercase tracking-wider text-slate-400">Journal / Conference Name
                <span class="text-cyan-400">*</span></label>
              <div class="relative">
                <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-600">
                  <i class="fas fa-scroll"></i>
                </span>
                <input id="publishedIn" type="text" name="publishedIn" required placeholder="e.g. ICAECA 2025" class="w-full rounded-xl border border-white/10 bg-[#0b0f19]/60 py-3 pl-11 pr-4 text-sm text-white placeholder:text-slate-600 transition duration-200 focus:border-cyan-500/20 focus:outline-none focus:ring-2 focus:ring-cyan-500/30" />
              </div>
            </div>

            <!-- Publisher -->
            <div class="space-y-2">
              <label for="publisher" class="block text-xs font-semibold uppercase tracking-wider text-slate-400">Publisher Body</label>
              <div class="relative">
                <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-600">
                  <i class="fas fa-print"></i>
                </span>
                <input id="publisher" type="text" name="publisher" placeholder="e.g. IEEE, Springer, ACM" class="w-full rounded-xl border border-white/10 bg-[#0b0f19]/60 py-3 pl-11 pr-4 text-sm text-white placeholder:text-slate-600 transition duration-200 focus:border-cyan-500/20 focus:outline-none focus:ring-2 focus:ring-cyan-500/30" />
              </div>
            </div>

            <!-- Release Date -->
            <div class="space-y-2">
              <label for="publishedAt" class="block text-xs font-semibold uppercase tracking-wider text-slate-400">Release Date <span class="text-cyan-400">*</span></label>
              <div class="relative">
                <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-600">
                  <i class="fas fa-calendar-alt"></i>
                </span>
                <input id="publishedAt" type="date" name="publishedAt" required class="w-full cursor-pointer rounded-xl border border-white/10 bg-[#0b0f19]/60 py-3 pl-11 pr-4 text-sm text-white transition duration-200 focus:border-cyan-500/20 focus:outline-none focus:ring-2 focus:ring-cyan-500/30" />
              </div>
            </div>
          </div>
        </fieldset>

        <!-- SEGMENT 3: Abstract & Promotion -->
        <fieldset class="space-y-6 border-t border-white/5 pt-6">
          <legend class="mb-4 text-xs font-bold uppercase tracking-wider text-cyan-400">
            <i class="fas fa-align-left mr-2"></i>3. Abstract Summary &amp;
            Promotion
          </legend>

          <div class="space-y-5">
            <!-- Featured toggle -->
            <label class="flex max-w-md cursor-pointer items-center justify-between gap-5 rounded-xl border border-white/10 bg-[#0b0f19]/40 px-5 py-4 transition duration-200 hover:border-cyan-500/20">
              <div class="flex items-center gap-3">
                <span class="text-slate-500">
                  <i class="fas fa-star text-lg"></i>
                </span>
                <div>
                  <p class="text-sm font-medium text-white">
                    Highlight Feature Positioning
                  </p>
                  <p class="text-[11px] leading-relaxed text-slate-500">
                    Pinned visibility inside your primary portfolio dashboard
                    landing modules.
                  </p>
                </div>
              </div>
              <input type="checkbox" name="featured" value="true" class="h-5 w-5 shrink-0 cursor-pointer rounded border-white/10 bg-[#0b0f19]/60 accent-cyan-500 text-cyan-500 focus:ring-0 focus:ring-offset-0" />
            </label>

            <!-- Abstract -->
            <div class="space-y-2">
              <div class="flex items-center justify-between gap-4">
                <label for="abstract" class="block text-xs font-semibold uppercase tracking-wider text-slate-400">Paper Abstract / Narrative Summary
                  <span class="text-cyan-400">*</span></label>
                <span id="char-counter" class="shrink-0 font-mono text-[10px] text-slate-600">0 / 1000 Chars</span>
              </div>
              <textarea id="abstract" name="abstract" rows="8" required maxlength="1000" placeholder="Paste the comprehensive baseline abstract structural summary exactly matching your scientific indexing paper configuration..." class="w-full resize-none rounded-xl border border-white/10 bg-[#0b0f19]/60 px-4 py-4 text-sm leading-relaxed text-white placeholder:text-slate-600 transition duration-200 focus:border-cyan-500/20 focus:outline-none focus:ring-2 focus:ring-cyan-500/30"></textarea>
            </div>
          </div>
        </fieldset>


        <!-- Actions -->
        <div class="flex flex-col-reverse items-center justify-end gap-4 border-t border-white/5 pt-8 sm:flex-row">
          <a href="/research/publications" class="w-full rounded-xl px-6 py-3 text-center text-xs font-semibold tracking-wide text-slate-400 transition duration-200 hover:text-white sm:w-auto">
            Cancel &amp; Exit
          </a>
          <button type="submit" class="w-full rounded-xl bg-cyan-600 px-8 py-3.5 text-xs font-bold uppercase tracking-wider text-white shadow-lg shadow-cyan-600/10 transition-all duration-200 hover:scale-[1.02] hover:bg-cyan-500 active:scale-[0.98] sm:w-auto">
            <i class="fas fa-floppy-disk mr-2"></i>Save Record Entry
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<!-- Live abstract character tracking -->
<script>
  (() => {
    const abstractField = document.getElementById("abstract");
    const charCounter = document.getElementById("char-counter");
    const MAX_CHARS = 1000;
    const COUNTER_BASE = "shrink-0 font-mono text-[10px]";

    const renderCounter = () => {
      const length = abstractField.value.length;
      charCounter.textContent = `${length} / ${MAX_CHARS} Chars`;

      if (length >= MAX_CHARS) {
        charCounter.className = `${COUNTER_BASE} text-rose-500`;
      } else if (length >= 900) {
        charCounter.className = `${COUNTER_BASE} text-amber-500`;
      } else {
        charCounter.className = `${COUNTER_BASE} text-slate-600`;
      }
    };

    abstractField.addEventListener("input", renderCounter);
    renderCounter();
  })();
</script>