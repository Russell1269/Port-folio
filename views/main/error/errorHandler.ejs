<% layout('layout/boilerplate') -%>

<section class="relative min-h-[75vh] flex items-center justify-center py-20 overflow-hidden">

  <div class="absolute -top-20 left-0 w-80 h-80 rounded-full bg-cyan-500/10 blur-[130px] pointer-events-none">
  </div>

  <div class="absolute bottom-0 right-0 w-[420px] h-[420px] rounded-full bg-purple-500/10 blur-[150px] pointer-events-none">
  </div>

  <div class="relative z-10 w-full max-w-3xl mx-auto px-4 sm:px-6">

    <div class="relative overflow-hidden rounded-[32px] border border-white/10 bg-white/5 backdrop-blur-2xl p-7 sm:p-10 lg:p-14 text-center shadow-[0_30px_80px_rgba(0,0,0,.35)]">

      <div class="absolute -top-20 left-1/2 -translate-x-1/2 w-64 h-64 rounded-full bg-cyan-500/10 blur-[100px] pointer-events-none">
      </div>

      <div class="relative z-10">

        <div class="mx-auto flex h-20 w-20 sm:h-24 sm:w-24 items-center justify-center rounded-[26px] border border-red-400/20 bg-red-500/10 text-red-300">

          <i class="fa-solid fa-triangle-exclamation text-3xl sm:text-4xl"></i>

        </div>

        <p class="mt-8 text-sm font-medium uppercase tracking-[0.3em] text-cyan-300">
          <%= status === 404 ? t('common:error.notFound') : t('common:error.generic') %>
        </p>

        <h1 class="mt-4 text-6xl sm:text-7xl lg:text-8xl font-bold tracking-tight text-white">
          <%= status || 500 %>
        </h1>

        <h2 class="mt-5 text-2xl sm:text-3xl font-semibold text-white">
          <%= status === 404 ? t('common:error.notFound') : t('common:error.generic') %>
        </h2>

        <p class="mt-5 max-w-xl mx-auto text-sm sm:text-base leading-7 text-slate-400">
          <%= message
                            || "The page could not be loaded right now. Please try again or return to the homepage." %>
        </p>

        <div class="mt-10 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-4">

          <a href="/" class="inline-flex items-center justify-center gap-3 rounded-2xl bg-gradient-to-r from-cyan-500 to-purple-500 px-7 py-4 font-semibold text-white transition duration-300 hover:-translate-y-1 hover:shadow-[0_15px_40px_rgba(34,211,238,.18)]">
            <i class="fa-solid fa-house"></i>
            Back to Home
          </a>

          <button type="button" onclick="window.history.back()" class="inline-flex items-center justify-center gap-3 rounded-2xl border border-white/10 bg-white/5 px-7 py-4 font-medium text-slate-300 backdrop-blur-xl transition duration-300 hover:border-cyan-400/30 hover:bg-white/10 hover:text-white">
            <i class="fa-solid fa-arrow-left"></i>
            Go Back
          </button>

        </div>

        <div class="mt-10 pt-8 border-t border-white/10">

          <p class="text-xs sm:text-sm text-slate-500">
            If the problem continues, you can
            <a href="/contact" class="text-cyan-300 transition hover:text-cyan-200">
              contact me
            </a>
            and report the issue.
          </p>

        </div>

      </div>

    </div>

  </div>

</section>