              <span class="lx-label lx-label--muted"><%= t('home:current.progressLabel') %></span>
              <span class="lx-bar__pct lx-num"><%= formatNumber(80) %><%= t('common:symbol.percent') %></span>
            </div>
            <div class="lx-bar__track" role="progressbar" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100" aria-label="<%= t('home:current.progressAria', { name: t('home:current.name') }) %>">
              <span class="lx-bar__fill" style="width: 80%"></span>
