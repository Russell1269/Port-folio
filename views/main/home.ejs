<!-- ===================================================== -->
<!-- GITHUB ACTIVITY -->
<!-- ===================================================== -->

<section id="github" class="lx-section">
  <div class="lx-block lx-block--spine">

    <!-- Heading -->

    <div class="lx-wide-head">
      <p class="lx-numeral" aria-hidden="true">IV.</p>
      <p class="lx-label lx-label--gold"><%= t('home:github.label') %></p>
      <h2 class="lx-statement lx-wide-head__statement"><%= t('home:github.title') %></h2>
      <p class="lx-body lx-wide-head__body">
        <%= t('home:github.body') %>
      </p>
    </div>

    <div class="lx-github">

      <!-- ======================================== -->
      <!-- PROFILE -->
      <!-- ======================================== -->

      <div class="lx-github__profile">

        <!-- Square portrait, kept the same wherever the person appears -->
        <img src="<%= github.profile.avatar %>" alt="<%= t('home:github.avatarAlt', { name: github.profile.name }) %>" loading="lazy" decoding="async" width="128" height="128" class="lx-github__avatar">

        <h3 class="lx-title">
          <%= github.profile.name %>
        </h3>

        <p class="lx-label lx-label--gold lx-github__handle">
          @<%= github.profile.username %>
        </p>

        <p class="lx-body">
          <%= github.profile.bio %>
        </p>

        <!-- Info -->

        <ul class="lx-github__info">
          <% if(github.profile.location){ %>
          <li>
            <i class="fas fa-location-dot" aria-hidden="true"></i>
            <span><%= github.profile.location %></span>
          </li>
          <% } %>

          <% if(github.profile.company){ %>
          <li>
            <i class="fas fa-building" aria-hidden="true"></i>
            <span><%= github.profile.company %></span>
          </li>
          <% } %>

          <li>
            <i class="fas fa-calendar" aria-hidden="true"></i>
            <span><%= t('home:github.joined', { date: formatDate(github.profile.joined, { month: 'long', year: 'numeric', day: undefined }) }) %></span>
          </li>
        </ul>

        <a href="<%= github.profile.githubUrl %>" target="_blank" rel="noopener" class="lx-link">
          <%= t('home:github.visit') %> <span aria-hidden="true">↗</span>
        </a>

      </div>


      <!-- ======================================== -->
      <!-- HEATMAP -->
      <!-- ======================================== -->

      <div class="lx-github__heat">
        <div class="lx-github__heat-head">
          <div>
            <h3 class="lx-item-title"><%= t('home:github.heatmapTitle') %></h3>
            <p class="lx-meta"><%= t('home:github.heatmapMeta') %></p>
          </div>
          <i class="fab fa-github" aria-hidden="true"></i>
        </div>

        <!-- Closed weeks of recent public activity: 13 week columns x 7 days.
             Only real events are drawn, so this never claims a full year of
             contributions the public events feed does not contain. -->

        <% const heatDays = github.contributions.slice(0, 91); %>
        <% const levelFor = (type) => ({ PushEvent: 3, PullRequestEvent: 2, IssuesEvent: 2 }[type] || 1); %>
        <ol class="lx-heat__track" aria-label="<%= t('home:github.heatmapAria') %>">
          <% heatDays.forEach(day=>{ %>
          <li class="lx-heat__cell" data-level="<%= levelFor(day.type) %>" title="<%= day.repo %> · <%= day.type %>">
            <span class="lx-sr-only"><%= t('home:github.cellLabel', { repo: day.repo, type: day.type, date: formatDate(day.date) }) %></span>
          </li>
          <% }); %>
        </ol>
        <% if(!heatDays.length){ %>
        <p class="lx-meta"><%= t('home:github.emptyHeatmap') %></p>
        <% } %>

        <!-- Legend -->

        <div class="lx-heat__legend">
          <span><%= t('home:github.legendFewer') %></span>
          <span data-level="1"></span>
          <span data-level="2"></span>
          <span data-level="3"></span>
          <span><%= t('home:github.legendMore') %></span>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ===================================================== -->
<!-- GITHUB STATS -->
<!-- ===================================================== -->

<section class="lx-section lx-section--flush-top">
  <div class="lx-block lx-block--spine">

    <!-- Statistics -->

    <ul class="lx-facts lx-stats">
      <!-- Repo -->
      <li>
        <p class="lx-label lx-label--gold"><%= t('home:github.stats.publicKicker') %></p>
        <p class="lx-figure-value lx-num"><%= formatNumber(github.stats.publicRepos) %></p>
        <p class="lx-label lx-label--muted lx-stats__label"><%= t('home:github.stats.repositories') %></p>
      </li>

      <!-- Stars -->
      <li>
        <p class="lx-label lx-label--gold"><%= t('home:github.stats.starsKicker') %></p>
        <p class="lx-figure-value lx-num"><%= formatNumber(github.stats.totalStars) %></p>
        <p class="lx-label lx-label--muted lx-stats__label"><%= t('home:github.stats.totalStars') %></p>
      </li>

      <!-- Followers -->
      <li>
        <p class="lx-label lx-label--gold"><%= t('home:github.stats.followersKicker') %></p>
        <p class="lx-figure-value lx-num"><%= formatNumber(github.stats.followers) %></p>
        <p class="lx-label lx-label--muted lx-stats__label"><%= t('home:github.stats.followers') %></p>
      </li>

      <!-- Following -->
      <li>
        <p class="lx-label lx-label--gold"><%= t('home:github.stats.followingKicker') %></p>
        <p class="lx-figure-value lx-num"><%= formatNumber(github.stats.following) %></p>
        <p class="lx-label lx-label--muted lx-stats__label"><%= t('home:github.stats.following') %></p>
      </li>
    </ul>


    <!-- ===================================================== -->
    <!-- LANGUAGES -->
    <!-- ===================================================== -->

    <div class="lx-two-cols lx-languages">

      <!-- Languages: aligned open columns -->

      <div>
        <h3 class="lx-item-title"><%= t('home:github.languages.title') %></h3>
        <p class="lx-meta lx-languages__note"><%= t('home:github.languages.note') %></p>

        <ul class="lx-bars">
          <% github.languages.forEach(language=>{ %>
          <li>
            <div class="lx-bar__head">
              <span><%= language.name %></span>
              <span class="lx-bar__pct"><%= formatNumber(language.percentage) %><%= t('common:symbol.percent') %></span>
            </div>
            <div class="lx-bar__track">
              <span class="lx-bar__fill" style="width: <%= language.percentage %>%"></span>
            </div>
          </li>
          <% }); %>
        </ul>
      </div>

      <!-- Development Focus -->

      <div class="lx-languages__focus">
        <h3 class="lx-item-title"><%= t('home:github.languages.focusTitle') %></h3>

        <ul class="lx-tags lx-languages__tags">
          <% t('home:github.languages.focusTags', { returnObjects: true }).forEach((tag) => { %>
          <li><%= tag %></li>
          <% }); %>
        </ul>

        <blockquote class="lx-quote lx-languages__quote">
          <%= t('home:github.languages.quote') %>
        </blockquote>
      </div>

    </div>
  </div>
</section>

<section class="lx-section lx-section--flush-top">
  <div class="lx-block lx-block--spine lx-repos-block">
    <div class="lx-wide-head">
      <p class="lx-numeral" aria-hidden="true">V.</p>
      <p class="lx-label lx-label--gold"><%= t('home:github.repos.label') %></p>
      <h2 class="lx-statement lx-wide-head__statement"><%= t('home:github.repos.title') %></h2>
      <p class="lx-body lx-wide-head__body">
        <%= t('home:github.repos.body') %>
      </p>
    </div>
  </div>

  <!-- Repository entries: one large editorial image, smaller stacked entries -->

  <div class="lx-block lx-repos">
    <figure class="lx-repos__lead">
      <img src="<%= github.profile.avatar %>" alt="" loading="lazy" decoding="async" width="640" height="640" />
      <figcaption><%= t('home:github.repos.imageCaption', { username: github.profile.username }) %></figcaption>
    </figure>

    <div class="lx-repos__list">
      <% github.repositories.forEach(repo=>{ %>
      <article class="lx-repo">
        <!-- Header -->

        <div class="lx-repo__head">
          <h3 class="lx-item-title lx-repo__name">
            <%= repo.name %>
          </h3>

          <span class="lx-label lx-repo__lang">
            <%= repo.language %>
          </span>
        </div>

        <p class="lx-repo__text">
          <%= repo.description || t('home:github.repos.noDescription') %>
        </p>

        <!-- Stats -->

        <div class="lx-repo__stats">
          <span><i class="fas fa-star" aria-hidden="true"></i> <span class="lx-num"><%= formatNumber(repo.stars) %></span> <%= t('home:github.repos.stars') %></span>
          <span><i class="fas fa-code-branch" aria-hidden="true"></i> <span class="lx-num"><%= formatNumber(repo.forks) %></span> <%= t('home:github.repos.forks') %></span>
        </div>

        <!-- Footer -->

        <div class="lx-repo__foot">
          <span class="lx-meta lx-repo__updated">
            <%- t('home:github.repos.updated', { date: `<time datetime="${repo.updatedAt}">${formatDate(repo.updatedAt)}</time>`, interpolation: { escapeValue: false } }) %>
          </span>

          <div class="lx-actions lx-repo__actions">
            <% if(repo.homepage){ %>
            <a href="<%= repo.homepage %>" target="_blank" rel="noopener" class="lx-link"><%= t('home:github.repos.liveSite') %></a>
            <% } %>

            <a href="<%= repo.githubUrl %>" target="_blank" rel="noopener" class="lx-link" aria-label="<%= t('home:github.repos.openOnGitHub', { name: repo.name }) %>">GitHub</a>
          </div>
        </div>
      </article>
      <% }) %>
    </div>
  </div>


  <!-- Learn more -->

  <div class="lx-block lx-repos-cta-wrap">
    <div class="lx-repos-cta">
      <p class="lx-label lx-label--gold"><%= t('home:github.repos.ctaLabel') %></p>
      <h2 class="lx-statement lx-repos-cta__title"><%= t('home:github.repos.ctaTitle') %></h2>
      <p class="lx-body">
        <%= t('home:github.repos.ctaBody') %>
      </p>
      <a href="<%= github.profile.githubUrl %>" target="_blank" rel="noopener" class="lx-link">
        <i class="fab fa-github" aria-hidden="true"></i>
        <%= t('home:github.repos.ctaLink') %> <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<!-- ===================================================== -->
<!-- ENGAGEMENT OPTIONS -->
<!-- ===================================================== -->

<section id="engagement" class="lx-section" aria-labelledby="engagement-title">
  <div class="lx-block lx-block--spine">
    <div class="lx-wide-head">
      <p class="lx-numeral" aria-hidden="true">VI.</p>
      <p class="lx-label lx-label--gold"><%= t('home:engagement.label') %></p>
      <h2 id="engagement-title" class="lx-statement lx-wide-head__statement"><%= t('home:engagement.title') %></h2>
      <p class="lx-body lx-wide-head__body">
        <%= t('home:engagement.body') %>
      </p>
    </div>

    <table class="lx-compare">
      <caption class="lx-compare__caption">
        <%= t('home:engagement.caption') %>
      </caption>
      <thead>
        <tr>
          <th scope="col" class="lx-compare__dim"><%= t('home:engagement.detailsHeading') %></th>

          <th scope="col" data-plan="project">
            <span class="lx-label lx-compare__kicker"><span class="lx-compare__check" aria-hidden="true"></span><%= t('home:engagement.plans.project.kicker') %></span>
            <span class="lx-compare__title lx-item-title"><%= t('home:engagement.plans.project.title') %></span>
          </th>

          <th scope="col" data-plan="ongoing">
            <span class="lx-label lx-compare__kicker"><span class="lx-compare__check" aria-hidden="true"></span><%= t('home:engagement.plans.ongoing.kicker') %></span>
            <!-- <span class="lx-compare__title lx-item-title"><%= t('home:engagement.plans.ongoing.title') %></span> -->
          </th>

          <th scope="col" data-plan="advisory">
            <span class="lx-label lx-compare__kicker"><span class="lx-compare__check" aria-hidden="true"></span><%= t('home:engagement.plans.advisory.kicker') %></span>
            <span class="lx-compare__title lx-item-title"><%= t('home:engagement.plans.advisory.title') %></span>
          </th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row"><%= t('home:engagement.rows.bestFor') %></th>
          <td data-plan="project"><%= t('home:engagement.cells.projectBestFor') %></td>
          <td data-plan="ongoing"><%= t('home:engagement.cells.ongoingBestFor') %></td>
          <td data-plan="advisory"><%= t('home:engagement.cells.advisoryBestFor') %></td>
        </tr>
        <tr>
          <th scope="row"><%= t('home:engagement.rows.engagement') %></th>
          <td data-plan="project"><%= t('home:engagement.cells.projectEngagement') %></td>
          <td data-plan="ongoing"><%= t('home:engagement.cells.ongoingEngagement') %></td>
          <td data-plan="advisory"><%= t('home:engagement.cells.advisoryEngagement') %></td>
        </tr>
        <tr>
          <th scope="row"><%= t('home:engagement.rows.startWith') %></th>
          <td data-plan="project"><a href="<%= localizedUrl('/projects') %>" class="lx-link"><%= t('home:engagement.cells.projectStart') %></a></td>
          <td data-plan="ongoing"><a href="<%= localizedUrl('/contact') %>#hire" class="lx-link"><%= t('home:engagement.cells.ongoingStart') %></a></td>
          <td data-plan="advisory"><a href="<%= localizedUrl('/research/publications') %>" class="lx-link"><%= t('home:engagement.cells.advisoryStart') %></a></td>
        </tr>
      </tbody>
    </table>

    <form class="lx-compare__form" data-compare-form data-selected-template="<%= t('home:engagement.form.selected', { names: '__NAMES__' }) %>" data-empty-label="<%= t('home:engagement.form.nothing') %>">
      <fieldset>
        <legend class="lx-label lx-label--muted"><%= t('home:engagement.form.legend') %></legend>
        <div class="lx-compare__options">
          <label class="lx-compare__option"><input type="checkbox" name="plan" value="project" /><%= t('home:engagement.plans.project.kicker') %></label>
          <label class="lx-compare__option"><input type="checkbox" name="plan" value="ongoing" checked /><%= t('home:engagement.plans.ongoing.kicker') %></label>
          <label class="lx-compare__option"><input type="checkbox" name="plan" value="advisory" /><%= t('home:engagement.plans.advisory.kicker') %></label>
        </div>
      </fieldset>
      <p class="lx-compare__status" role="status" aria-live="polite"><%= t('home:engagement.form.selected', { names: t('home:engagement.plans.ongoing.kicker') }) %></p>
    </form>
  </div>
</section>

<!-- ===================================================== -->
<!-- CLOSING FIELD -->
<!-- ===================================================== -->

<section class="lx-close lx-field lx-door" id="close" aria-labelledby="close-title">
  <div class="lx-door__content lx-close__content">
    <div class="lx-close__title-col">
      <h2 id="close-title" class="lx-close__title"><%- t('home:close.title') %></h2>
    </div>

    <figure class="lx-close__image">
      <!-- Repeats a detail of the opening photograph: the same room, cropped
           in tight to its armchair and lamp. Decorative, so empty alt text. -->
      <img src="https://images.unsplash.com/photo-1524758631624-e2822e304c36?q=80&w=900&auto=format&fit=crop" style="object-fit: cover; object-position: 28% 72%;" alt="" width="450" height="600" loading="lazy" decoding="async" />
    </figure>

    <div class="lx-close__copy">
      <p class="lx-label lx-label--gold"><%= t('home:close.status') %></p>
      <p class="lx-body">
        <%= t('home:close.body') %>
      </p>
      <div class="lx-actions">
        <a href="<%= localizedUrl('/contact') %>" class="lx-btn"><%= t('home:close.cta') %></a>
        <a href="https://drive.google.com/uc?export=download&id=1Ez877agXDpwgNpuFyDrsb3ATdtY1Rdlj" download="MD_Rasel_Hasan_Resume.pdf" class="lx-link"><%= t('home:close.resume') %></a>
      </div>
    </div>
  </div>
</section>