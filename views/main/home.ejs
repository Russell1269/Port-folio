      <li>
        <p class="lx-figure-value lx-num"><%= t('home:current.facts.cloudValue') %></p>
        <p class="lx-label lx-label--muted"><%= t('home:current.facts.cloudLabel') %></p>
      </li>
      <li>
        <p class="lx-figure-value lx-num"><%= t('home:current.facts.releaseValue') %></p>
        <p class="lx-label lx-label--muted"><%= t('home:current.facts.releaseLabel') %></p>
      </li>
    </ul>
  </div>
</section>
