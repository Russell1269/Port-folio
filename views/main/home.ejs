<% layout('layout/boilerplate') -%>

<% /* Home page. Every visible string comes from the `home` namespace. */ %>

<%
  const marquee = [
    { key: 'react', icon: 'fab fa-react' },
    { key: 'next', glyph: '▲' },
    { key: 'node', icon: 'fab fa-node-js' },
    { key: 'express', icon: 'fas fa-server' },
    { key: 'mongodb', icon: 'fas fa-database' },
    { key: 'tailwind', icon: 'fab fa-css3-alt' },
    { key: 'javascript', icon: 'fab fa-js' },
    { key: 'python', icon: 'fab fa-python' },
    { key: 'machineLearning', icon: 'fas fa-brain' },
    { key: 'ai', icon: 'fas fa-robot' },
    { key: 'git', icon: 'fab fa-git-alt' },
    { key: 'rest', icon: 'fas fa-cloud' },
  ];
%>

<section id="hero" class="lx-section lx-hero">
  <div class="lx-block lx-block--spine">
    <p class="lx-label lx-label--gold lx-status lx-hero__status"><%= t('home:hero.status') %></p>

    <div class="lx-hero__grid">
      <!-- LEFT: title spans across the margin, then body in columns three to seven -->

      <div class="lx-hero__intro">
        <h1 class="lx-display">
          <%- t('home:hero.title') %>
        </h1>

        <p class="lx-body lx-body-lg lx-hero__lead">
          <%- t('home:hero.lead', { name: t('footer:brand.name') }) %>
        </p>

        <div class="lx-actions lx-hero__actions">
          <a href="<%= localizedUrl('/projects') %>" class="lx-btn"><%= t('home:hero.exploreProjects') %></a>

          <a href="https://drive.google.com/uc?export=download&id=1Ez877agXDpwgNpuFyDrsb3ATdtY1Rdlj" download="MD_Rasel_Hasan_Resume.pdf" class="lx-link">
            <%= t('home:hero.downloadResume') %>
          </a>
        </div>

        <nav class="lx-hero__social" aria-label="<%= t('home:hero.socialLabel') %>">
          <a href="https://github.com/Russell1269" target="_blank" aria-label="GitHub"><i class="fab fa-github" aria-hidden="true"></i> <%= t('footer:link.github') %></a>
          <a href="https://www.linkedin.com/in/rasel-hasan-66a755445/" target="_blank" aria-label="LinkedIn"><i class="fab fa-linkedin" aria-hidden="true"></i> LinkedIn</a>
          <a href="https://www.facebook.com/rh.raselhasan552/" target="_blank" aria-label="Facebook"><i class="fab fa-facebook" aria-hidden="true"></i> Facebook</a>
          <a href="mailto:rasel.hasan1563@gmail.com" target="_blank" aria-label="<%= t('footer:link.email') %>"><i class="fas fa-envelope" aria-hidden="true"></i> <%= t('footer:link.email') %></a>
        </nav>
      </div>

      <!-- RIGHT: portrait crossing into the following taupe field -->

      <figure class="lx-figure lx-figure--framed lx-hero__portrait" data-door-crop>
        <img src="https://res.cloudinary.com/dsyog2ibh/image/upload/v1793993618/891565429_1811294713540495_7470820260889288968_n_ghatxg.jpg" alt="<%= t('home:hero.portraitAlt') %>" width="800" height="1000" fetchpriority="high" decoding="async" style="object-position: 55% 50%" />
        <figcaption><%= t('home:hero.portraitCaption') %></figcaption>
      </figure>
    </div>
  </div>
</section>

<div class="lx-hero__facts-band">
  <div class="lx-block">
    <!-- Concise supporting facts from the brief -->
    <ul class="lx-facts">
      <li>
        <p class="lx-figure-value lx-num"><%= formatNumber(23) %>+</p>
        <p class="lx-label lx-label--muted"><%= t('home:facts.projects.label') %></p>
      </li>
      <li>
        <p class="lx-figure-value lx-num"><%= formatNumber(20) %>+</p>
        <p class="lx-label lx-label--muted"><%= t('home:facts.technologies.label') %></p>
      </li>
      <li>
        <p class="lx-figure-value lx-num"><%= t('home:facts.responsive.value') %></p>
        <p class="lx-label lx-label--muted"><%= t('home:facts.responsive.label') %></p>
      </li>
      <li>
        <p class="lx-figure-value lx-num"><%= t('home:facts.product.value') %></p>
        <p class="lx-label lx-label--muted"><%= t('home:facts.product.label') %></p>
      </li>
    </ul>
  </div>
</div>

<!-- ===================================================== -->
<!-- TECH MARQUEE -->
<!-- ===================================================== -->

<section class="lx-section lx-section--flush-top" aria-label="<%= t('home:marquee.label') %>">
  <div class="lx-block">
    <div class="lx-marquee">
      <!-- Marquee track: the list plus its aria-hidden duplicate must be exactly 50% + half a gap wide for a seamless loop -->
      <div class="lx-marquee__track">

        <!-- Primary List -->
        <ul class="lx-marquee__list">
          <% marquee.forEach((item) => { %>
          <li><%- item.glyph ? `<i aria-hidden="true">${item.glyph}</i>` : `<i class="${item.icon}" aria-hidden="true"></i>` %> <%= t(`home:marquee.${item.key}`) %></li>
          <% }); %>
        </ul>

        <!-- Duplicated Secondary List for seamless loop transition -->
        <ul class="lx-marquee__list" aria-hidden="true">
          <% marquee.forEach((item) => { %>
          <li><%- item.glyph ? `<i>${item.glyph}</i>` : `<i class="${item.icon}"></i>` %> <%= t(`home:marquee.${item.key}`) %></li>
          <% }); %>
        </ul>
      </div>
    </div>
  </div>
</section>


<div class="lx-block lx-scroll-cue-wrap">
  <a href="<%= localizedUrl('/about') %>" class="lx-link lx-scroll-cue">
    <span class="lx-scroll-cue__mouse" aria-hidden="true"><span></span></span>
    <%= t('home:scrollCue.about') %>
  </a>
</div>

<!-- MY EXPERTISE -->

<section id="expertise" class="lx-section">
  <div class="lx-block lx-block--spine">
    <div class="lx-split">
      <!-- Section heading beside ruled rows; heading holds on a wide layout -->
      <div class="lx-split__head lx-sticky">
        <p class="lx-numeral" aria-hidden="true">I.</p>
        <p class="lx-label lx-label--gold"><%= t('home:expertise.label') %></p>
        <h2 class="lx-statement lx-split__title">
          <%= t('home:expertise.title') %>
        </h2>
        <p class="lx-body">
          <%= t('home:expertise.body') %>
        </p>
      </div>

      <div class="lx-split__body">
        <ul class="lx-rows">
          <% ['fullstack', 'ai', 'uiux', 'research'].forEach((key, index) => { %>
          <li class="lx-row">
            <span class="lx-row__num" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %></span>
            <h3 class="lx-row__title lx-item-title"><%= t(`home:expertise.${key}.title`) %></h3>
            <p class="lx-row__text">
              <%= t(`home:expertise.${key}.text`) %>
            </p>
            <ul class="lx-row__tags lx-tags">
              <% t(`home:expertise.${key}.tags`, { returnObjects: true }).forEach((tag) => { %>
              <li><%= tag %></li>
              <% }); %>
            </ul>
          </li>
          <% }); %>
        </ul>
      </div>
    </div>
  </div>
</section>

